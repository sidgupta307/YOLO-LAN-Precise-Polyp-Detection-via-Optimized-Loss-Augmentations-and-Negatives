"""
=========================================================
Purpose:
Evaluate false positives on unseen negative colonoscopy
images and compute:

1. Specificity
2. False Positive Images
3. False Positives Per Image (FPPI)
4. Confidence statistics

Outputs:
---------
summary.txt
summary.csv
image_wise_results.csv
false_detections.csv
annotated_images/

=========================================================
"""

import os
import cv2
import numpy as np
import pandas as pd
from tqdm import tqdm
from ultralytics import YOLO

# =========================================================
# USER SETTINGS
# =========================================================

MODEL_PATH = r"C:\Medical_image_analysis\BKAI-IGH NeoPolyp\bkai-igh-neopolyp\results\yolov8_with_augmentation_10_negative\yolov8_l_with_augmentation_10_negative\weights\best.pt"

NEGATIVE_IMAGE_DIR = r"C:\Medical_image_analysis\yolov8_kvasir\2_neg\images\negative_test_images"

OUTPUT_DIR = r"C:\Medical_image_analysis\Reviewer_Negative_Test"

CONFIDENCE_THRESHOLD = 0.25

IOU_THRESHOLD = 0.45

IMAGE_EXTENSIONS = (
    ".jpg",
    ".jpeg",
    ".png",
    ".bmp",
    ".tif",
    ".tiff",
)

# =========================================================
# CREATE OUTPUT FOLDERS
# =========================================================

ANNOTATED_DIR = os.path.join(
    OUTPUT_DIR,
    "annotated_images"
)

os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(ANNOTATED_DIR, exist_ok=True)

# =========================================================
# LOAD MODEL
# =========================================================

print("=" * 60)
print("Loading YOLO model...")
print("=" * 60)

model = YOLO(MODEL_PATH)

print("Model Loaded Successfully\n")

# =========================================================
# GET IMAGE LIST
# =========================================================

image_paths = []

for file in sorted(os.listdir(NEGATIVE_IMAGE_DIR)):

    if file.lower().endswith(IMAGE_EXTENSIONS):

        image_paths.append(
            os.path.join(
                NEGATIVE_IMAGE_DIR,
                file
            )
        )

TOTAL_IMAGES = len(image_paths)

print(f"Negative images found : {TOTAL_IMAGES}")

if TOTAL_IMAGES == 0:

    raise RuntimeError(
        "No images found in negative image directory."
    )

# =========================================================
# VARIABLES FOR FINAL STATISTICS
# =========================================================

true_negative_images = 0

false_positive_images = 0

total_false_detections = 0

all_confidences = []

image_results = []

detection_results = []

print("\nInitialization Complete.")
print("=" * 60)

# =========================================================
# PART 2
# RUN INFERENCE ON NEGATIVE IMAGES
# =========================================================

print("\n")
print("=" * 60)
print("Running inference on negative images...")
print("=" * 60)

for image_path in tqdm(image_paths):

    image_name = os.path.basename(image_path)

    image = cv2.imread(image_path)

    if image is None:

        print(f"Could not read {image_name}")
        continue

    # -----------------------------------------------
    # Run YOLO inference
    # -----------------------------------------------

    results = model.predict(
        source=image,
        conf=CONFIDENCE_THRESHOLD,
        iou=IOU_THRESHOLD,
        verbose=False
    )

    result = results[0]

    boxes = result.boxes

    # -----------------------------------------------
    # No detections
    # -----------------------------------------------

    if boxes is None or len(boxes) == 0:

        true_negative_images += 1

        image_results.append({

            "image": image_name,
            "num_detections": 0,
            "status": "True Negative",
            "max_confidence": 0.0

        })

        continue

    # -----------------------------------------------
    # False Positive Image
    # -----------------------------------------------

    false_positive_images += 1

    num_detections = len(boxes)

    total_false_detections += num_detections

    confidences = []

    annotated = image.copy()

    # -----------------------------------------------
    # Process each false detection
    # -----------------------------------------------

    for det_id, box in enumerate(boxes):

        confidence = float(box.conf.cpu().numpy())

        cls = int(box.cls.cpu().numpy())

        xyxy = box.xyxy.cpu().numpy()[0]

        x1, y1, x2, y2 = map(int, xyxy)

        confidences.append(confidence)

        all_confidences.append(confidence)

        detection_results.append({

            "image": image_name,
            "detection_id": det_id + 1,
            "class": cls,
            "confidence": confidence,
            "xmin": x1,
            "ymin": y1,
            "xmax": x2,
            "ymax": y2

        })

        # ---------------------------------------
        # Draw detection
        # ---------------------------------------

        cv2.rectangle(
            annotated,
            (x1, y1),
            (x2, y2),
            (0, 0, 255),
            2
        )

        label = f"FP {confidence:.2f}"

        cv2.putText(
            annotated,
            label,
            (x1, max(20, y1 - 8)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (0, 0, 255),
            2
        )

    # -----------------------------------------------
    # Save annotated image
    # -----------------------------------------------

    save_path = os.path.join(
        ANNOTATED_DIR,
        image_name
    )

    cv2.imwrite(
        save_path,
        annotated
    )

    image_results.append({

        "image": image_name,
        "num_detections": num_detections,
        "status": "False Positive",
        "max_confidence": max(confidences)

    })

print("\nInference Complete.")
print("=" * 60)

# =========================================================
# PART 3
# CALCULATE REVIEWER METRICS
# =========================================================

print("\n")
print("=" * 60)
print("Calculating evaluation metrics...")
print("=" * 60)

# ---------------------------------------------------------
# Basic Counts
# ---------------------------------------------------------

total_images = TOTAL_IMAGES

TN = true_negative_images

FP_images = false_positive_images

FP_detections = total_false_detections

# ---------------------------------------------------------
# Specificity
# ---------------------------------------------------------

if (TN + FP_images) > 0:
    specificity = TN / (TN + FP_images)
else:
    specificity = 0.0

specificity_percent = specificity * 100

# ---------------------------------------------------------
# False Positives Per Image (FPPI)
# Reviewer requested metric
# ---------------------------------------------------------

if total_images > 0:
    FPPI = FP_detections / total_images
else:
    FPPI = 0.0

# ---------------------------------------------------------
# Percentage of Images with False Positives
# ---------------------------------------------------------

if total_images > 0:
    fp_image_percent = (FP_images / total_images) * 100
else:
    fp_image_percent = 0.0

# ---------------------------------------------------------
# Detection Confidence Statistics
# ---------------------------------------------------------

if len(all_confidences) > 0:

    mean_confidence = float(np.mean(all_confidences))

    median_confidence = float(np.median(all_confidences))

    std_confidence = float(np.std(all_confidences))

    max_confidence = float(np.max(all_confidences))

    min_confidence = float(np.min(all_confidences))

else:

    mean_confidence = 0.0

    median_confidence = 0.0

    std_confidence = 0.0

    max_confidence = 0.0

    min_confidence = 0.0

# ---------------------------------------------------------
# Average False Detections
# Only among images that contain false detections
# ---------------------------------------------------------

if FP_images > 0:

    avg_fp_per_fp_image = FP_detections / FP_images

else:

    avg_fp_per_fp_image = 0.0

# ---------------------------------------------------------
# Reviewer Summary Dictionary
# ---------------------------------------------------------

summary = {

    "Negative Test Images": total_images,

    "True Negative Images": TN,

    "False Positive Images": FP_images,

    "Total False Detections": FP_detections,

    "Specificity": specificity,

    "Specificity (%)": specificity_percent,

    "False Positives Per Image (FPPI)": FPPI,

    "False Positive Image (%)": fp_image_percent,

    "Average FP Per FP Image": avg_fp_per_fp_image,

    "Mean Confidence": mean_confidence,

    "Median Confidence": median_confidence,

    "Std Confidence": std_confidence,

    "Minimum Confidence": min_confidence,

    "Maximum Confidence": max_confidence

}

# ---------------------------------------------------------
# Print Results
# ---------------------------------------------------------

print("\n")
print("=" * 60)
print("NEGATIVE TEST RESULTS")
print("=" * 60)

print(f"Negative Images             : {total_images}")

print(f"True Negatives              : {TN}")

print(f"False Positive Images       : {FP_images}")

print(f"Total False Detections      : {FP_detections}")

print(f"Specificity                 : {specificity_percent:.2f}%")

print(f"False Positives / Image     : {FPPI:.4f}")

print(f"False Positive Images (%)   : {fp_image_percent:.2f}%")

print(f"Average FP / FP Image       : {avg_fp_per_fp_image:.2f}")

print(f"Mean Confidence             : {mean_confidence:.4f}")

print(f"Median Confidence           : {median_confidence:.4f}")

print(f"Maximum Confidence          : {max_confidence:.4f}")

print("=" * 60)

# =========================================================
# PART 4
# SAVE RESULTS
# =========================================================

print("\n")
print("=" * 60)
print("Saving evaluation results...")
print("=" * 60)

# ---------------------------------------------------------
# Save Image-wise Results
# ---------------------------------------------------------

image_results_df = pd.DataFrame(image_results)

image_results_csv = os.path.join(
    OUTPUT_DIR,
    "image_wise_results.csv"
)

image_results_df.to_csv(
    image_results_csv,
    index=False
)

# ---------------------------------------------------------
# Save Detection-wise Results
# ---------------------------------------------------------

detection_results_df = pd.DataFrame(detection_results)

detection_results_csv = os.path.join(
    OUTPUT_DIR,
    "false_detections.csv"
)

detection_results_df.to_csv(
    detection_results_csv,
    index=False
)

# ---------------------------------------------------------
# Save Summary CSV
# ---------------------------------------------------------

summary_df = pd.DataFrame(
    [summary]
)

summary_csv = os.path.join(
    OUTPUT_DIR,
    "summary.csv"
)

summary_df.to_csv(
    summary_csv,
    index=False
)

# ---------------------------------------------------------
# Save Summary TXT
# ---------------------------------------------------------

summary_txt = os.path.join(
    OUTPUT_DIR,
    "summary.txt"
)

with open(summary_txt, "w") as f:

    f.write("=" * 70 + "\n")
    f.write("NEGATIVE ONLY EVALUATION REPORT\n")
    f.write("=" * 70 + "\n\n")

    f.write(f"Model Path : {MODEL_PATH}\n")
    f.write(f"Image Folder : {NEGATIVE_IMAGE_DIR}\n\n")

    f.write("-" * 70 + "\n")
    f.write("RESULTS\n")
    f.write("-" * 70 + "\n")

    f.write(f"Negative Test Images        : {total_images}\n")
    f.write(f"True Negative Images        : {TN}\n")
    f.write(f"False Positive Images       : {FP_images}\n")
    f.write(f"Total False Detections      : {FP_detections}\n\n")

    f.write(f"Specificity                 : {specificity:.6f}\n")
    f.write(f"Specificity (%)             : {specificity_percent:.2f}\n")
    f.write(f"False Positives/Image       : {FPPI:.6f}\n")
    f.write(f"False Positive Images (%)   : {fp_image_percent:.2f}\n")
    f.write(f"Average FP / FP Image       : {avg_fp_per_fp_image:.4f}\n\n")

    f.write("Confidence Statistics\n")
    f.write("------------------------------\n")

    f.write(f"Mean Confidence             : {mean_confidence:.6f}\n")
    f.write(f"Median Confidence           : {median_confidence:.6f}\n")
    f.write(f"Std Confidence              : {std_confidence:.6f}\n")
    f.write(f"Minimum Confidence          : {min_confidence:.6f}\n")
    f.write(f"Maximum Confidence          : {max_confidence:.6f}\n")

# ---------------------------------------------------------
# Print Output Locations
# ---------------------------------------------------------

print("\nResults successfully saved.\n")

print("Files Created:\n")

print(image_results_csv)

print(detection_results_csv)

print(summary_csv)

print(summary_txt)

print(ANNOTATED_DIR)

print("\nDone.")
print("=" * 60)

# =========================================================
# PART 5
# REVIEWER-READY SUMMARY
# =========================================================

print("\n")
print("=" * 70)
print("IEEE ACCESS REVIEWER SUMMARY")
print("=" * 70)

reviewer_summary = f"""
