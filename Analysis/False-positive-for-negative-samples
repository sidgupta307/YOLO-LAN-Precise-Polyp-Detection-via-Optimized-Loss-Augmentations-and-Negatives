# =========================================================
# FINAL MESSAGE
# =========================================================

print("\n")
print("=" * 70)
print("NEGATIVE-ONLY EVALUATION COMPLETED SUCCESSFULLY")
print("=" * 70)

print(f"Negative Images            : {total_images}")
